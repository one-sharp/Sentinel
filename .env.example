# 本地配置文件示例：复制为 .env 后填写。不要把真实 Key 公开或提交 Git。
LLM_API_KEY=YOUR_API_KEY

# 任选一个兼容 OpenAI Chat Completions 的模型服务；下面只是示例，请按实际使用的平台修改。
# DeepSeek 示例：LLM_BASE_URL=https://api.deepseek.com ; LLM_MODEL=deepseek-flash
# OpenAI 示例：LLM_BASE_URL=https://api.openai.com/v1 ; LLM_MODEL=<你的模型名称>
LLM_BASE_URL=https://YOUR_PROVIDER_OPENAI_COMPATIBLE_ENDPOINT/v1
LLM_MODEL=YOUR_MODEL_NAME

# system：沿用 Windows 系统代理；direct：仅本程序的 LLM 请求直连。
# 如果出现 Connection error / SSL EOF，可用 direct 排除系统代理故障。
LLM_NETWORK_MODE=system

# 可选：本场需要重点关注什么（也可用命令行 --goal 覆盖）
EVENT_GOAL=关注重要变化和需要当场确认的内容
